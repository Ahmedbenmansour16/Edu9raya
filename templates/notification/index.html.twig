{% extends 'base_front.html.twig' %}

{% block title %}Notifications - Edu9raya{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .notification-list {
            max-width: 800px;
            margin: 0 auto;
        }
        .notification-item {
            padding: 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            background-color: #f8f9fa;
            border-left: 4px solid #007bff;
            transition: all 0.3s ease;
        }
        .notification-item:hover {
            background-color: #e9ecef;
        }
        .notification-meta {
            font-size: 0.875rem;
            color: #6c757d;
        }
        .notification-actions {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
            margin-top: 0.5rem;
        }
        .empty-notifications {
            text-align: center;
            padding: 3rem;
            color: #6c757d;
        }
    </style>
{% endblock %}

{% block body %}
    <!-- Page Title Section -->
    <section class="page-title" style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('{{ asset('assets/img/hero-bg.jpg') }}') center/cover; padding: 100px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center text-white">
                    <h1>Notifications</h1>
                    <p>Stay updated with your upcoming events</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Notifications Section -->
    <section class="notifications-section" style="padding: 60px 0;">
        <div class="container">
            <div class="notification-list">
                {% if notifications|length > 0 %}
                    {% for notification in notifications %}
                        <div class="notification-item" data-notification-id="{{ notification.id }}">
                            <div class="notification-content">
                                <p class="mb-2">{{ notification.message }}</p>
                                <div class="notification-meta">
                                    <span>{{ notification.createdAt|date('M j, Y H:i') }}</span>
                                </div>
                            </div>
                            <div class="notification-actions">
                                <a href="{{ path('app_front_event_show', {'id': notification.event.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="fas fa-eye"></i> View Event
                                </a>
                                <form method="post" action="{{ path('app_notification_mark_read', {'id': notification.id}) }}" style="display: inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('mark-read' ~ notification.id) }}">
                                    <button type="button" class="btn btn-sm btn-success mark-as-read" data-id="{{ notification.id }}">
                                        <i class="fas fa-check"></i> Mark as Read
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="empty-notifications">
                        <i class="fas fa-bell fa-3x mb-3"></i>
                        <h4>No New Notifications</h4>
                        <p>You're all caught up! Check back later for updates about your upcoming events.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const markAsReadButtons = document.querySelectorAll('.mark-as-read');
            
            markAsReadButtons.forEach(button => {
                button.addEventListener('click', async function() {
                    const notificationId = this.dataset.id;
                    const form = this.closest('form');
                    const token = form.querySelector('input[name="_token"]').value;

                    try {
                        const response = await fetch(`/notifications/mark-read/${notificationId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': token
                            }
                        });

                        if (!response.ok) {
                            throw new Error('Failed to mark notification as read');
                        }

                        // Remove the notification from the UI
                        const notificationItem = document.querySelector(`[data-notification-id="${notificationId}"]`);
                        if (notificationItem) {
                            notificationItem.remove();
                        }

                        // If no more notifications, show empty state
                        const remainingNotifications = document.querySelectorAll('.notification-item');
                        if (remainingNotifications.length === 0) {
                            const notificationList = document.querySelector('.notification-list');
                            notificationList.innerHTML = `
                                <div class="empty-notifications">
                                    <i class="fas fa-bell fa-3x mb-3"></i>
                                    <h4>No New Notifications</h4>
                                    <p>You're all caught up! Check back later for updates about your upcoming events.</p>
                                </div>
                            `;
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        alert('Failed to mark notification as read. Please try again.');
                    }
                });
            });
        });
    </script>
{% endblock %}
