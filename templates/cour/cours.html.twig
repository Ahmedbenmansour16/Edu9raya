{% extends 'student/base.html.twig' %}

{% block body %}
<div class="container">
  <div class="row">
    {% for cour in pagination %}
      <div class="col-lg-4 col-md-6 d-flex align-items-stretch mt-4" data-aos="zoom-in" data-aos-delay="300">
        <div class="course-item shadow-sm p-3 mb-5 bg-white rounded">
          <img src="{{ asset('assetfront/img/course-3.jpg') }}" class="img-fluid rounded-top" alt="...">
          <div class="course-content p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="category badge bg-success text-white p-2">{{ cour.module.nom }}</p>
            </div>

            <h3><a href="course-details.html" class="text-decoration-none text-dark">{{ cour.Categorie }}</a></h3>
            <p class="description text-muted">{{ cour.titre }}</p>
            <div class="trainer d-flex justify-content-between align-items-center mt-3">
              <div class="trainer-profile d-flex align-items-center">
                <img src="assets/img/trainers/trainer-3-2.jpg" class="img-fluid rounded-circle me-2" width="40" height="40" alt="">
                <a href="#" class="trainer-link text-success text-decoration-none fw-bold">Brandon</a>
              </div>
              <div class="trainer-rank d-flex align-items-center text-muted">
                <i class="bi bi-person user-icon"></i>&nbsp;20
                &nbsp;&nbsp;
                <i class="bi bi-heart heart-icon"></i>&nbsp;85
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <!-- Pagination améliorée avec couleur verte -->
  <div class="pagination-container d-flex justify-content-center mt-4">
    <ul class="pagination">
      {{ knp_pagination_render(pagination, '@KnpPaginator/Pagination/twitter_bootstrap_v4_pagination.html.twig') }}
    </ul>
  </div>
</div>

<style>
  .pagination-container .pagination {
      display: flex;
      gap: 5px;
  }

  .pagination-container .pagination .page-item {
      border: 1px solid #28a745;
      border-radius: 5px;
      padding: 8px 12px;
      transition: all 0.3s ease-in-out;
  }

  .pagination-container .pagination .page-item a {
      text-decoration: none;
      color: #28a745;
      font-weight: bold;
      padding: 8px 12px;
  }

  .pagination-container .pagination .page-item.active {
      background-color: #28a745;
      color: white;
  }

  .pagination-container .pagination .page-item:hover {
      background-color: #218838;
      color: white;
  }

  .course-item {
      transition: transform 0.3s ease-in-out;
  }

  .course-item:hover {
      transform: translateY(-5px);
      box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
  }
</style>
{% endblock %}
