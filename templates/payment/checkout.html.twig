{% extends 'base_front.html.twig' %}

{% block title %}Payment for {{ event.titre }} - Edu9raya{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .payment-form {
            max-width: 600px;
            margin: 40px auto;
            padding: 20px;
        }
        .event-details {
            margin-bottom: 2rem;
            padding: 1.5rem;
            border-radius: 8px;
            background: #f8f9fa;
        }
        #payment-element {
            margin-bottom: 24px;
            padding: 20px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
        }
        #payment-message {
            color: rgb(105, 115, 134);
            font-size: 16px;
            line-height: 20px;
            padding-top: 12px;
            text-align: center;
        }
        .payment-button {
            background: #5469d4;
            color: #ffffff;
            border-radius: 4px;
            border: 0;
            padding: 12px 16px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: block;
            width: 100%;
            transition: all 0.2s ease;
        }
        .payment-button:hover {
            filter: contrast(115%);
        }
        .payment-button:disabled {
            opacity: 0.5;
            cursor: default;
        }
        .currency-note {
            font-size: 0.9rem;
            color: #666;
            margin-top: 0.5rem;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="page-title" style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('{{ asset('assets/img/hero-bg.jpg') }}') center/cover; padding: 100px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center text-white">
                    <h1>Event Registration Payment</h1>
                    <h4 class="mt-3">{{ event.titre }}</h4>
                </div>
            </div>
        </div>
    </section>

    <div class="container my-5">
        <div class="payment-form">
            <!-- Event Details -->
            <div class="event-details mb-4">
                <h5 class="mb-3">Event Details</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Event:</strong> {{ event.titre }}</p>
                        <p><strong>Date:</strong> {{ event.dateDebut|date('d M Y') }}</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Location:</strong> {{ event.lieu }}</p>
                        <p><strong>Spots Left:</strong> {{ event.nbrParticipantsMax }}</p>
                    </div>
                </div>
                <div class="mt-3">
                    <p><strong>Amount to Pay:</strong> TND {{ amount }}</p>
                    <p class="currency-note">* Payment will be processed in USD (approximately ${{ (amount * 0.32)|number_format(2) }})</p>
                </div>
            </div>

            <!-- Payment Form -->
            <form id="payment-form" class="mt-4">
                <div id="payment-element"></div>
                <button type="submit" class="payment-button mt-4" id="submit">
                    <div class="spinner d-none" id="spinner"></div>
                    <span id="button-text">Pay Now (USD {{ (amount * 0.32)|number_format(2) }})</span>
                </button>
                <div id="payment-message" class="mt-4 alert" style="display: none;"></div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const stripe = Stripe('{{ stripe_public_key }}');
            const paymentForm = document.getElementById('payment-form');
            const submitButton = document.getElementById('submit');
            const messageDiv = document.getElementById('payment-message');

            let elements;
            let paymentElement;

            async function initialize() {
                try {
                    showMessage('Initializing payment...', 'info');
                    const response = await fetch("{{ path('create_payment_intent', {'id': event.id}) }}", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                        }
                    });

                    if (!response.ok) {
                        const errorData = await response.json();
                        throw new Error(errorData.error || 'Failed to create payment intent');
                    }

                    const data = await response.json();
                    
                    if (data.error) {
                        throw new Error(data.error);
                    }

                    const { clientSecret } = data;
                    if (!clientSecret) {
                        throw new Error('No client secret received');
                    }

                    elements = stripe.elements({
                        clientSecret,
                        appearance: {
                            theme: 'stripe',
                            variables: {
                                colorPrimary: '#5469d4',
                            },
                        },
                    });

                    paymentElement = elements.create("payment");
                    await paymentElement.mount("#payment-element");
                    showMessage('Ready for payment', 'success');
                } catch (error) {
                    console.error('Payment initialization error:', error);
                    showMessage(error.message || 'Failed to initialize payment', 'error');
                    submitButton.disabled = true;
                }
            }

            initialize();

            paymentForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                setLoading(true);

                try {
                    const { error } = await stripe.confirmPayment({
                        elements,
                        confirmParams: {
                            return_url: "{{ url('payment_event_success', {'id': event.id}) }}",
                        },
                    });

                    if (error) {
                        throw error;
                    }
                } catch (error) {
                    console.error('Payment confirmation error:', error);
                    showMessage(error.message || 'An unexpected error occurred', 'error');
                }

                setLoading(false);
            });

            function showMessage(messageText, type = 'error') {
                messageDiv.textContent = messageText;
                messageDiv.style.display = 'block';
                messageDiv.className = 'mt-4 alert alert-' + 
                    (type === 'error' ? 'danger' : 
                     type === 'success' ? 'success' : 'info');
            }

            function setLoading(isLoading) {
                submitButton.disabled = isLoading;
                document.querySelector("#spinner").classList.toggle('d-none', !isLoading);
                document.querySelector("#button-text").classList.toggle('d-none', isLoading);
            }
        });
    </script>
{% endblock %}
