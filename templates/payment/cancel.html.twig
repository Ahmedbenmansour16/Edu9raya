{% extends 'base_front.html.twig' %}

{% block title %}Payment Cancelled - Edu9raya{% endblock %}

{% block body %}
    <!-- Page Title Section -->
    <section class="page-title" style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('{{ asset('assets/img/hero-bg.jpg') }}') center/cover; padding: 100px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center text-white">
                    <h1>Payment Cancelled</h1>
                    <p>Your payment was not completed</p>
                </div>
            </div>
        </div>
    </section>

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="card shadow-sm">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <i class="fas fa-times-circle text-danger" style="font-size: 4rem;"></i>
                        </div>
                        <h2 class="mb-4">Payment Cancelled</h2>
                        <p class="lead mb-4">Your payment was not completed. If you experienced any issues, please try again or contact our support team.</p>
                        <div class="d-flex justify-content-center gap-3">
                            <a href="{{ path('payment_checkout') }}" class="btn btn-primary">
                                <i class="fas fa-redo me-2"></i> Try Again
                            </a>
                            <a href="{{ path('app_front_events') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Return to Events
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
