{% extends 'base.html.twig' %}

{% block title %}Liste des Feedbacks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .content-wrapper {
            padding: 20px;
            background: #f4f6f9;
        }
        
        .card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px 15px 0 0;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-body {
            padding: 25px;
        }

        .table {
            border-radius: 10px;
            overflow: hidden;
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            margin-bottom: 0;
        }

        .table th {
            background: #2196F3;
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            padding: 15px;
            border: none;
            text-align: center;
        }

        .table td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #e9ecef;
            text-align: center;
            color: #495057;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
            transition: background-color 0.2s ease;
        }

        .fa-star {
            font-size: 1rem;
            margin: 0 1px;
        }

        .text-warning {
            color: #ffc107 !important;
        }

        .btn-group {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn i {
            margin-right: 5px;
        }

        .btn-info {
            background: #2196F3;
            color: white;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .btn-info:hover {
            background: #1976D2;
        }

        .btn-danger:hover {
            background: #c82333;
        }

        .alert-info {
            background: #e3f2fd;
            color: #1976D2;
            border: none;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            font-weight: 500;
        }

        .remarks-cell {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .rating-stars {
            color: #ffc107;
            font-size: 1.2rem;
        }

        @media (max-width: 768px) {
            .table-responsive {
                border-radius: 10px;
                overflow: hidden;
            }
            
            .btn {
                padding: 6px 12px;
            }
            
            .card-header {
                padding: 15px;
            }
            
            .card-title {
                font-size: 1.2rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-comments me-2"></i>
                                Liste des Feedbacks
                            </h3>
                        </div>
                        <div class="card-body">
                            {% if feedback|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>ID Participant</th>
                                                <th>Note</th>
                                                <th>Remarque</th>
                                                <th>Date</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for feedback in feedback %}
                                            <tr>
                                                <td>{{ feedback.idParticipant }}</td>
                                                <td class="rating-stars">
                                                    {% for i in 1..feedback.note %}
                                                        <i class="fas fa-star"></i>
                                                    {% endfor %}
                                                    {% for i in feedback.note+1..5 %}
                                                        <i class="far fa-star"></i>
                                                    {% endfor %}
                                                    ({{ feedback.note }}/5)
                                                </td>
                                                <td class="remarks-cell">{{ feedback.remarque }}</td>
                                                <td>{{ feedback.dateFeedback ? feedback.dateFeedback|date('Y-m-d H:i:s') : '' }}</td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('app_feedback_show', {'id': feedback.id}) }}" 
                                                           class="btn btn-info" 
                                                           title="Voir les détails">
                                                            <i class="fas fa-eye"></i> Voir
                                                        </a>
                                                        <form method="post" 
                                                              action="{{ path('app_feedback_delete', {'id': feedback.id}) }}" 
                                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce feedback ?');" 
                                                              style="display: inline-block;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ feedback.id) }}">
                                                            <button class="btn btn-danger" title="Supprimer">
                                                                <i class="fas fa-trash"></i> Supprimer
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Aucun feedback trouvé.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
