{% extends 'base_front.html.twig' %}

{% block title %}{{ evenement.titre }} - Edu9raya{% endblock %}

{% block body %}
    <!-- Event Details Section -->
    <section class="event-details" style="padding: 80px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <div class="col-lg-8">
                    <article class="event-details-content">
                        <img src="{{ asset('assets/img/event-default.jpg') }}" alt="{{ evenement.titre }}" class="img-fluid mb-4">

                        <h2 class="title">{{ evenement.titre }}</h2>

                        <div class="meta-top mb-4">
                            <ul class="list-inline">
                                <li class="list-inline-item">
                                    <i class="bi bi-calendar"></i> {{ evenement.dateDebut ? evenement.dateDebut|date('Y-m-d') : '' }}
                                </li>
                                <li class="list-inline-item">
                                    <i class="bi bi-geo-alt"></i> {{ evenement.lieu }}
                                </li>
                                <li class="list-inline-item">
                                    <i class="bi bi-tag"></i> {{ evenement.typeEvent }}
                                </li>
                            </ul>
                        </div>

                        <div class="content">
                            <p>{{ evenement.description }}</p>
                        </div>
                    </article>
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Event Details</h5>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <strong>Status:</strong> 
                                    <span class="badge {% if evenement.status == 'Planifié' %}bg-success{% else %}bg-danger{% endif %}">
                                        {{ evenement.status }}
                                    </span>
                                </li>
                                <li class="mb-2">
                                    <strong>Start Date:</strong> {{ evenement.dateDebut ? evenement.dateDebut|date('Y-m-d') : '' }}
                                </li>
                                <li class="mb-2">
                                    <strong>End Date:</strong> {{ evenement.dateFin ? evenement.dateFin|date('Y-m-d') : '' }}
                                </li>
                                <li class="mb-2">
                                    <strong>Location:</strong> {{ evenement.lieu }}
                                </li>
                                <li class="mb-2">
                                    <strong>Type:</strong> {{ evenement.typeEvent }}
                                </li>
                                <li class="mb-2">
                                    <strong>Max Participants:</strong> {{ evenement.nbrParticipantsMax }}
                                </li>
                            </ul>

                            <button class="btn btn-primary w-100" onclick="window.location.href='#'">Learn More</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related Events Section -->
    <section class="related-events" style="padding: 60px 0; background-color: #f8f9fa;">
        <div class="container" data-aos="fade-up">
            <h3 class="mb-4">Other Events You May Like</h3>
            <div class="row">
                {% for i in 1..3 %}
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="{{ asset('assets/img/event-default.jpg') }}" class="card-img-top" alt="Related Event">
                            <div class="card-body">
                                <h5 class="card-title">Sample Event {{ i }}</h5>
                                <p class="card-text">This is a sample related event description...</p>
                                <a href="{{ path('app_front_home') }}#events" class="btn btn-sm btn-primary">View All Events</a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
