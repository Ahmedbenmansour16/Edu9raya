{% extends 'base_front.html.twig' %}

{% block title %}{{ evenement.titre }} - Edu9raya{% endblock %}

{% block body %}
    <!-- Event Header -->
    <section class="page-title" style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('{{ asset('assets/img/hero-bg.jpg') }}') center/cover; padding: 100px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center text-white">
                    <h1>{{ evenement.titre }}</h1>
                    <div class="mt-3">
                        <span class="badge {% if evenement.status == 'Planifié' %}bg-success{% elseif evenement.status == 'En cours' %}bg-primary{% else %}bg-secondary{% endif %} mb-2">
                            {{ evenement.status }}
                        </span>
                        <span class="badge bg-info">{{ evenement.typeEvent }}</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Event Details -->
    <section class="event-details" style="padding: 60px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <!-- Event Image -->
                    <div class="mb-4">
                        <img src="{{ asset('assets/img/event-default.jpg') }}" class="img-fluid rounded" alt="{{ evenement.titre }}">
                    </div>

                    <!-- Event Info -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h4 class="card-title mb-4">Event Details</h4>
                            
                            <div class="event-meta mb-4">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <p class="mb-2"><i class="fas fa-map-marker-alt text-primary"></i> Location</p>
                                        <h6>{{ evenement.lieu }}</h6>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p class="mb-2"><i class="fas fa-users text-primary"></i> Capacity</p>
                                        <h6>{{ evenement.nbrParticipantsMax }} participants max</h6>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p class="mb-2"><i class="fas fa-calendar-start text-primary"></i> Start Date</p>
                                        <h6>{{ evenement.dateDebut ? evenement.dateDebut|date('d M Y, H:i') : 'Not specified' }}</h6>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <p class="mb-2"><i class="fas fa-calendar-end text-primary"></i> End Date</p>
                                        <h6>{{ evenement.dateFin ? evenement.dateFin|date('d M Y, H:i') : 'Not specified' }}</h6>
                                    </div>
                                </div>
                            </div>

                            <div class="event-description">
                                <h5 class="mb-3">Description</h5>
                                <p>{{ evenement.description }}</p>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_front_events') }}" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left me-2"></i> Back to Events
                        </a>
                        <a href="{{ path('app_front_feedback_new', {'eventId': evenement.id}) }}" class="btn btn-primary">
                            <i class="fas fa-star me-2"></i> Rate this Event
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <style>
        .event-meta i {
            width: 24px;
            margin-right: 8px;
        }
        .badge {
            font-size: 0.9rem;
            padding: 0.5em 1em;
            margin: 0 0.2em;
        }
    </style>
{% endblock %}
