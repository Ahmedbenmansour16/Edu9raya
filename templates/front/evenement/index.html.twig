{% extends 'base.html.twig' %}

{% block title %}Events{% endblock %}

{% block body %}
    <!-- Events Section -->
    <section class="events-section py-5">
        <div class="container">
            <h2 class="text-center mb-4">Our Events</h2>
            
            <div class="row">
                {% for evenement in evenements %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">{{ evenement.titre }}</h5>
                                <p class="card-text">{{ evenement.description }}</p>
                                <ul class="list-unstyled">
                                    <li><strong>Location:</strong> {{ evenement.lieu }}</li>
                                    <li><strong>Start Date:</strong> {{ evenement.dateDebut ? evenement.dateDebut|date('Y-m-d H:i:s') : '' }}</li>
                                    <li><strong>End Date:</strong> {{ evenement.dateFin ? evenement.dateFin|date('Y-m-d H:i:s') : '' }}</li>
                                    <li><strong>Type:</strong> {{ evenement.typeEvent }}</li>
                                    <li><strong>Max Participants:</strong> {{ evenement.nbrParticipantsMax }}</li>
                                    <li><strong>Status:</strong> {{ evenement.status }}</li>
                                </ul>
                                <div class="mt-3">
                                    <a href="{{ path('app_front_evenement_show', {'id': evenement.id}) }}" class="btn btn-info">
                                        <i class="fas fa-eye me-1"></i> Show Details
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <a href="{{ path('app_front_feedback_new', {'eventId': evenement.id}) }}" class="btn btn-primary">
                                <i class="fas fa-star me-1"></i> Rate this Event
                            </a>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <p class="text-center">No events found</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
