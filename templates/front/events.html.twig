{% extends 'base_front.html.twig' %}

{% block title %}All Events - Edu9raya{% endblock %}

{% block body %}
    <!-- Page Title Section -->
    <section class="page-title" style="background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('{{ asset('assets/img/hero-bg.jpg') }}') center/cover; padding: 100px 0;">
        <div class="container" data-aos="fade-up">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center text-white">
                    <h1>All Events</h1>
                    <p>Browse through our comprehensive list of educational events</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Events Grid Section -->
    <section class="events-grid" style="padding: 60px 0;">
        <div class="container" data-aos="fade-up">
            <!-- Filters -->
            <div class="row mb-5">
                <div class="col-md-12">
                    <div class="d-flex flex-wrap justify-content-center gap-3">
                        <div class="filters d-flex flex-wrap gap-2">
                            <button class="btn btn-outline-primary active" data-filter="all">All</button>
                            <button class="btn btn-outline-primary" data-filter="upcoming">Upcoming</button>
                            <button class="btn btn-outline-primary" data-filter="past">Past</button>
                        </div>
                        <div class="divider mx-2"></div>
                        <a href="{{ path('app_front_feedbacks') }}" class="btn btn-outline-info">
                            <i class="fas fa-comments me-1"></i> My Feedbacks
                        </a>
                    </div>
                </div>
            </div>

            <!-- Events Grid -->
            <div class="row" id="events-container">
                {% for evenement in evenements %}
                    <div class="col-md-6 col-lg-4 mb-4 event-card" data-status="{{ evenement.status }}">
                        <div class="card h-100" data-aos="fade-up" data-aos-delay="{{ loop.index * 100 }}">
                            <img src="{{ asset('assets/img/event-default.jpg') }}" class="card-img-top" alt="{{ evenement.titre }}">
                            <div class="card-body d-flex flex-column">
                                <div class="mb-3">
                                    <span class="badge {% if evenement.status == 'Planifié' %}bg-success{% elseif evenement.status == 'En cours' %}bg-primary{% else %}bg-secondary{% endif %} mb-2">
                                        {{ evenement.status }}
                                    </span>
                                    <h5 class="card-title">{{ evenement.titre }}</h5>
                                    <p class="card-text">{{ evenement.description|slice(0, 100) }}...</p>
                                </div>
                                
                                <div class="event-meta mb-3">
                                    <p class="mb-2"><i class="fas fa-calendar"></i> {{ evenement.dateDebut|date('d M Y') }}</p>
                                    <p class="mb-2"><i class="fas fa-map-marker-alt"></i> {{ evenement.lieu }}</p>
                                    <p class="mb-0"><i class="fas fa-users"></i> {{ evenement.nbrParticipantsMax }} spots left</p>
                                </div>

                                <div class="mt-auto">
                                    <div class="d-flex flex-column gap-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <a href="{{ path('app_front_evenement_show', {'id': evenement.id}) }}" class="btn btn-primary">
                                                <i class="fas fa-eye me-1"></i> View Details
                                            </a>
                                            <span class="badge bg-info">{{ evenement.typeEvent }}</span>
                                        </div>
                                        {% if evenement.status == 'Planifié' %}
                                            {% if evenement.nbrParticipantsMax > 0 %}
                                                <a href="{{ path('payment_event_checkout', {'id': evenement.id}) }}" class="btn btn-success w-100">
                                                    <i class="fas fa-ticket-alt me-1"></i> Register Now (TND 10)
                                                </a>
                                            {% else %}
                                                <button class="btn btn-secondary w-100" disabled>
                                                    <i class="fas fa-ban me-1"></i> Fully Booked
                                                </button>
                                            {% endif %}
                                        {% else %}
                                            <button class="btn btn-secondary w-100" disabled>
                                                <i class="fas fa-clock me-1"></i> 
                                                {% if evenement.status == 'En cours' %}
                                                    Event In Progress
                                                {% else %}
                                                    Event Ended
                                                {% endif %}
                                            </button>
                                        {% endif %}
                                        <a href="{{ path('app_front_feedback_new', {'eventId': evenement.id}) }}" class="btn btn-outline-primary w-100">
                                            <i class="fas fa-star me-1"></i> Rate this Event
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <p class="text-center">No events found</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <style>
        .event-meta {
            font-size: 0.9rem;
            color: #6c757d;
        }
        .event-meta i {
            width: 20px;
            text-align: center;
            margin-right: 8px;
        }
        .card {
            transition: transform 0.3s ease;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .badge {
            font-size: 0.8rem;
            padding: 0.5em 1em;
        }
        .event-card {
            transition: all 0.3s ease;
        }
        .event-card.hidden {
            display: none;
        }
        .divider {
            width: 1px;
            background-color: #dee2e6;
            align-self: stretch;
        }
        @media (max-width: 576px) {
            .divider {
                display: none;
            }
            .d-flex.flex-wrap.justify-content-center {
                flex-direction: column;
                align-items: center;
            }
            .filters {
                margin-bottom: 1rem;
            }
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterButtons = document.querySelectorAll('.filters button');
            const eventsContainer = document.getElementById('events-container');
            const eventCards = document.querySelectorAll('.event-card');

            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    // Remove active class from all buttons
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    // Add active class to clicked button
                    this.classList.add('active');

                    const filter = this.getAttribute('data-filter');

                    eventCards.forEach(card => {
                        const status = card.getAttribute('data-status');
                        
                        if (filter === 'all') {
                            card.classList.remove('hidden');
                        } else if (filter === 'upcoming' && status === 'Planifié') {
                            card.classList.remove('hidden');
                        } else if (filter === 'past' && status === 'Terminé') {
                            card.classList.remove('hidden');
                        } else {
                            card.classList.add('hidden');
                        }
                    });

                    // Check if there are any visible cards
                    const visibleCards = document.querySelectorAll('.event-card:not(.hidden)');
                    const noEventsMessage = document.querySelector('.col-12');
                    
                    if (visibleCards.length === 0) {
                        if (!noEventsMessage) {
                            const message = document.createElement('div');
                            message.className = 'col-12 no-events-message';
                            message.innerHTML = '<p class="text-center">No events found for this filter</p>';
                            eventsContainer.appendChild(message);
                        }
                    } else {
                        const existingMessage = document.querySelector('.no-events-message');
                        if (existingMessage) {
                            existingMessage.remove();
                        }
                    }
                });
            });
        });
    </script>
{% endblock %}
