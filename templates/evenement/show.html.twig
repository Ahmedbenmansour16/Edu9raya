{% extends 'base.html.twig' %}

{% block title %}Détails de l'Événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .content-wrapper {
            padding: 20px;
            background: #f4f6f9;
        }
        
        .card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px 15px 0 0;
            border: none;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-body {
            padding: 25px;
        }

        .info-group {
            margin-bottom: 1.5rem;
        }

        .info-group label {
            font-weight: 600;
            color: #666;
            margin-bottom: 0.5rem;
            display: block;
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        .info-group p {
            margin: 0;
            font-size: 1.1rem;
            color: #333;
        }

        .status-badge {
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 500;
            display: inline-block;
            font-size: 1rem;
        }

        .status-planifie {
            background: #4CAF50;
            color: white;
        }

        .status-en-cours {
            background: #FFC107;
            color: #000;
        }

        .status-termine {
            background: #F44336;
            color: white;
        }

        .btn-group {
            margin-top: 2rem;
            display: flex;
            gap: 1rem;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn i {
            margin-right: 5px;
        }

        .btn-info {
            background: #2196F3;
            color: white;
        }

        .btn-primary {
            background: #2196F3;
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .description-box {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 10px;
            margin-top: 5px;
        }

        @media (max-width: 768px) {
            .btn-group {
                flex-direction: column;
            }
            
            .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-calendar-alt me-2"></i>
                                Détails de l'Événement
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="info-group">
                                        <label>Titre</label>
                                        <p>{{ evenement.titre }}</p>
                                    </div>

                                    <div class="info-group">
                                        <label>Status</label>
                                        <p>
                                            <span class="status-badge {{ evenement.status == 'Planifié' ? 'status-planifie' : (evenement.status == 'En cours' ? 'status-en-cours' : 'status-termine') }}">
                                                {{ evenement.status }}
                                            </span>
                                        </p>
                                    </div>

                                    <div class="info-group">
                                        <label>Type d'Événement</label>
                                        <p>{{ evenement.typeEvent }}</p>
                                    </div>

                                    <div class="info-group">
                                        <label>Lieu</label>
                                        <p>{{ evenement.lieu }}</p>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="info-group">
                                        <label>Date de Début</label>
                                        <p>{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y H:i') : '' }}</p>
                                    </div>

                                    <div class="info-group">
                                        <label>Date de Fin</label>
                                        <p>{{ evenement.dateFin ? evenement.dateFin|date('d/m/Y H:i') : '' }}</p>
                                    </div>

                                    <div class="info-group">
                                        <label>Nombre Maximum de Participants</label>
                                        <p>{{ evenement.nbrParticipantsMax }}</p>
                                    </div>
                                </div>
                            </div>

                            <div class="info-group">
                                <label>Description</label>
                                <div class="description-box">
                                    {{ evenement.description|nl2br }}
                                </div>
                            </div>

                            <div class="btn-group">
                                <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left"></i> Retour à la liste
                                </a>
                                <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>
                                {{ include('evenement/_delete_form.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function updateNotificationCount() {
            fetch('/notifications/count')
                .then(response => response.json())
                .then(data => {
                    const badge = document.getElementById('notification-count');
                    if (data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }
                })
                .catch(error => console.error('Error fetching notifications:', error));
        }

        // Update count immediately and then every minute
        updateNotificationCount();
        setInterval(updateNotificationCount, 60000);
    </script>
{% endblock %}
