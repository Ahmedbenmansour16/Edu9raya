{% extends 'base.html.twig' %}

{% block title %}Liste des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .content-wrapper {
            padding: 20px;
            background: #f4f6f9;
        }
        
        .card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            border: none;
        }

        .card-header {
            background: linear-gradient(135deg, #2196F3 0%, #1976D2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px 15px 0 0;
            border: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .card-tools .btn-primary {
            background: white;
            color: #2196F3;
            border: none;
            transition: all 0.2s ease;
        }

        .card-tools .btn-primary:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-1px);
        }

        .card-body {
            padding: 25px;
        }

        .table {
            border-radius: 10px;
            overflow: hidden;
            border-collapse: separate;
            border-spacing: 0;
            width: 100%;
            margin-bottom: 0;
        }

        .table th {
            background: #2196F3;
            color: white;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            padding: 15px;
            border: none;
            text-align: center;
        }

        .table td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #e9ecef;
            text-align: center;
            color: #495057;
        }

        .table tbody tr:last-child td {
            border-bottom: none;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
            transition: background-color 0.2s ease;
        }

        .btn-group {
            display: flex;
            gap: 8px;
            justify-content: center;
        }

        .btn {
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            text-decoration: none;
            border: none;
        }

        .btn i {
            margin-right: 5px;
        }

        .btn-info {
            background: #2196F3;
            color: white;
        }

        .btn-primary {
            background: #2196F3;
            color: white;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .btn-info:hover {
            background: #1976D2;
        }

        .btn-primary:hover {
            background: #1976D2;
        }

        .btn-danger:hover {
            background: #c82333;
        }

        .alert-info {
            background: #e3f2fd;
            color: #1976D2;
            border: none;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            font-weight: 500;
        }

        .description-cell {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 500;
            display: inline-block;
        }

        .status-planifie {
            background: #4CAF50;
            color: white;
        }

        .status-en-cours {
            background: #FFC107;
            color: #000;
        }

        .status-termine {
            background: #F44336;
            color: white;
        }

        @media (max-width: 768px) {
            .table-responsive {
                border-radius: 10px;
                overflow: hidden;
            }
            
            .btn {
                padding: 6px 12px;
            }
            
            .card-header {
                padding: 15px;
                flex-direction: column;
                gap: 10px;
            }
            
            .card-title {
                font-size: 1.2rem;
            }
        }

        .notification-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .notification-icon {
            position: relative;
            display: inline-block;
            padding: 10px;
            background: white;
            border-radius: 50%;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            margin-left: 10px;
        }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            background: #dc3545;
            color: white;
            border-radius: 50%;
            padding: 3px 6px;
            font-size: 12px;
            min-width: 20px;
            text-align: center;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-calendar-alt me-2"></i>
                                Liste des Événements
                            </h3>
                            <div class="card-tools">
                                <a href="{{ path('app_evenement_new') }}" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Ajouter un événement
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            {% if evenements|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Titre</th>
                                                <th>Description</th>
                                                <th>Date Début</th>
                                                <th>Date Fin</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for evenement in evenements %}
                                            <tr>
                                                <td>{{ evenement.titre }}</td>
                                                <td class="description-cell" title="{{ evenement.description }}">
                                                    {{ evenement.description }}
                                                </td>
                                                <td>{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y H:i') : '' }}</td>
                                                <td>{{ evenement.dateFin ? evenement.dateFin|date('d/m/Y H:i') : '' }}</td>
                                                <td>
                                                    <span class="status-badge {{ evenement.status == 'Planifié' ? 'status-planifie' : (evenement.status == 'En cours' ? 'status-en-cours' : 'status-termine') }}">
                                                        {{ evenement.status }}
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group">
                                                        <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" 
                                                           class="btn btn-info" 
                                                           title="Voir les détails">
                                                            <i class="fas fa-eye"></i> Voir
                                                        </a>
                                                        <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" 
                                                           class="btn btn-primary"
                                                           title="Modifier">
                                                            <i class="fas fa-edit"></i> Modifier
                                                        </a>
                                                        <form method="post" 
                                                              action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" 
                                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');" 
                                                              style="display: inline-block;">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                                            <button class="btn btn-danger" title="Supprimer">
                                                                <i class="fas fa-trash"></i> Supprimer
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% else %}
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    Aucun événement trouvé.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function updateNotificationCount() {
            fetch('/notifications/count')
                .then(response => response.json())
                .then(data => {
                    const badge = document.getElementById('notification-count');
                    if (data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }
                })
                .catch(error => console.error('Error fetching notifications:', error));
        }

        // Update count immediately and then every minute
        updateNotificationCount();
        setInterval(updateNotificationCount, 60000);
    </script>
{% endblock %}