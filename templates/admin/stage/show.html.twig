{% extends 'admin/base.html.twig' %}
{% block title %}Détails du Stage{% endblock %}
{% block stylesheets %}
<style>
  .category-container {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 24px;
  }
  
  .page-title {
    font-size: 28px;
    font-weight: 700;
    color: #111827;
    margin-bottom: 32px;
  }
  
  .card {
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
    padding: 24px;
    margin-bottom: 24px;
  }
  
  .btn {
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  
  .btn-secondary {
    background: #F3F4F6;
    color: #374151;
    border: 1px solid #E5E7EB;
  }
  
  .btn-secondary:hover {
    background: #E5E7EB;
  }
  
  .btn-warning {
    background: #FBBF24;
    color: #92400E;
    border: none;
  }
  
  .btn-warning:hover {
    background: #F59E0B;
    transform: translateY(-1px);
  }
  
  .detail-row {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  
  .detail-label {
    font-weight: 600;
    color: #374151;
    min-width: 100px;
  }
  
  .detail-value {
    color: #4B5563;
  }
</style>
{% endblock %}

{% block body %}
<div class="category-container">
  <h1 class="page-title">Détails du Stage</h1>
  
  <div class="card">
    <div class="detail-row">
      <span class="detail-label">ID :</span>
      <span class="detail-value">{{ stage.id }}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Titre :</span>
      <span class="detail-value">{{ stage.titre }}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Description :</span>
      <span class="detail-value">{{ stage.description|default('N/A') }}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Entreprise :</span>
      <span class="detail-value">{{ stage.entreprise }}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Lieu :</span>
      <span class="detail-value">{{ stage.lieu }}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Durée :</span>
      <span class="detail-value">{{ stage.duree }} mois</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Date de Début :</span>
      <span class="detail-value">{{ stage.dateDebut|date('Y-m-d') }}</span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Catégorie :</span>
      <span class="detail-value">{{ stage.categorie.nom }}</span>
    </div>
  </div>
  
  <div class="mt-4">
    <a href="{{ path('admin_stage_index') }}" class="btn btn-secondary">
      <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>
    <a href="{{ path('admin_stage_edit', { id: stage.id }) }}" class="btn btn-warning">
      <i class="fas fa-edit"></i> Modifier
    </a>
  </div>
</div>
{% endblock %}