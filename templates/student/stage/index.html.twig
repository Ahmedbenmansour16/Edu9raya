{% extends 'student/base.html.twig' %}

{% block title %}Liste des Stages{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Liste des Stages</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Entreprise</th>
                    <th>Lieu</th>
                    <th>Durée</th>
                    <th>Date de Début</th>
                    <th>Catégorie</th>
                    <th>Statut Candidature</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for stage in stages %}
                <tr>
                    <td>{{ stage.titre }}</td>
                    <td>{{ stage.entreprise }}</td>
                    <td>{{ stage.lieu }}</td>
                    <td>{{ stage.duree }} mois</td>
                    <td>{{ stage.dateDebut|date('d/m/Y') }}</td>
                    <td>{{ stage.categorie.nom }}</td>
                    <td>
                        {% set hasApplied = resumesByStage[stage.id] is not empty %}
                        {% if hasApplied %}
                            <span class="badge bg-success">Candidature Envoyée</span>
                        {% else %}
                            <span class="badge bg-warning">Non Candidaté</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('student_stage_show', {'id': stage.id}) }}" 
                           class="btn btn-sm btn-info">Voir</a>
                        {% if not hasApplied %}
                            <a href="{{ path('student_stage_apply', {'id': stage.id}) }}" 
                               class="btn btn-sm btn-primary">Postuler</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center">Aucun stage disponible.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}