{% extends 'student/base.html.twig' %}

{% block title %}Détails du Stage{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Détails du Stage</h1>

    <div class="card">
        <div class="card-body">
            <p><strong>Titre :</strong> {{ stage.titre }}</p>
            <p><strong>Description :</strong> {{ stage.description|default('N/A') }}</p>
            <p><strong>Entreprise :</strong> {{ stage.entreprise }}</p>
            <p><strong>Lieu :</strong> {{ stage.lieu }}</p>
            <p><strong>Durée :</strong> {{ stage.duree }} mois</p>
            <p><strong>Date de Début :</strong> {{ stage.dateDebut|date('d/m/Y') }}</p>
            <p><strong>Catégorie :</strong> {{ stage.categorie.nom }}</p>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('student_stage_index') }}" class="btn btn-secondary">Retour</a>
        <a href="{{ path('student_stage_apply', {'id': stage.id}) }}" class="btn btn-primary">Postuler</a>
    </div>
</div>
{% endblock %}