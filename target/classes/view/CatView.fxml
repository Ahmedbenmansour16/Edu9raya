<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CategorieViewController" stylesheets="/css/style.css">
    <children>
        <VBox spacing="10.0" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <!-- Zone de saisie -->
                <HBox spacing="10.0">
                    <children>
                        <Label text="ID Cat:"/>
                        <TextField fx:id="idCatField" promptText="Entrez l'ID Cat"/>
                        <Label text="Nom Cat:"/>
                        <TextField fx:id="nomCatField" promptText="Entrez le nom de la catégorie"/>
                    </children>
                </HBox>
                <!-- Boutons des opérations -->
                <HBox spacing="10.0">
                    <children>
                        <Button text="Ajouter" onAction="#handleAddCategorie"/>
                        <Button text="Mettre à jour" onAction="#handleUpdateCategorie"/>
                        <Button text="Supprimer" onAction="#handleDeleteCategorie"/>
                    </children>
                </HBox>
                <!-- TableView pour l'affichage des catégories -->
                <TableView fx:id="categorieTable" prefHeight="300.0" prefWidth="600.0">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
                        <TableColumn fx:id="idCatColumn" text="ID Cat" prefWidth="150.0"/>
                        <TableColumn fx:id="nomCatColumn" text="Nom Cat" prefWidth="200.0"/>
                    </columns>
                </TableView>
                <!-- Label de statut -->
                <Label fx:id="statusLabel" text="Statut..."/>
            </children>
        </VBox>
    </children>
</AnchorPane>
