<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.PdfViewController"
      spacing="8"
      alignment="TOP_CENTER"
      prefWidth="400" prefHeight="600"
      maxWidth="400" maxHeight="600"
      style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4; -fx-background-radius: 4;">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <!-- navigation bar -->
    <HBox spacing="12" alignment="CENTER">
        <Button fx:id="prevPageBtn"
                text="◀"
                onAction="#handlePrev"
                prefWidth="30"/>
        <Label fx:id="pageNumberLabel" text="0 / 0" />
        <Button fx:id="nextPageBtn"
                text="▶"
                onAction="#handleNext"
                prefWidth="30"/>
    </HBox>

    <!-- PDF rendering area -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                prefWidth="376" prefHeight="520"
                style="-fx-background:transparent; -fx-border-color: transparent;">
        <content>
            <ImageView fx:id="pdfImageView"
                       preserveRatio="true"
                       smooth="true"
                       fitWidth="360"/>
        </content>
    </ScrollPane>
</VBox>
