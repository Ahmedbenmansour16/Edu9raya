<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1200.0" stylesheets="@stylesRania.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserConsulterStageController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="nav-bar" stylesheets="@stylesRania.css">
         <children>
            <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
               <children>
                  <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../../Edu9raya-java/Edu9raya-java/src/main/resources/images/logo.jpg" />
                     </image>
                  </ImageView>
                  <Label styleClass="brand-name" text="Edu9raya">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Label>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </HBox>
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <Button fx:id="homeBtn" mnemonicParsing="false" styleClass="nav-button" text="Home" />
                  <Button fx:id="formationBtn" mnemonicParsing="false" styleClass="nav-button" text="Formation" />
                  <Button fx:id="reclamationsBtn" mnemonicParsing="false" styleClass="nav-button" text="Mes réclamations" />
                  <Button fx:id="StageBtn" mnemonicParsing="false" text="Stage">
                     <styleClass>
                        <String fx:value="nav-button" />
                        <String fx:value="active-nav" />
                     </styleClass></Button>
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="userNameLabel" styleClass="user-name-label">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Label>
                  <Button fx:id="profileBtn" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" styleClass="profile-btn">
                     <graphic>
                        <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../../../Edu9raya-java/Edu9raya-java/src/main/resources/images/profile.jpg" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <Button fx:id="logoutBtn" mnemonicParsing="false" styleClass="logout-btn" text="Déconnexion">
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </HBox>
         </children>
      </HBox>
   </top>
   <center>
      <VBox fx:id="stagesList" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: white;">
               <children>
                  <TextField fx:id="recherche" promptText="Recherche" />
               </children>
               <VBox.margin>
                  <Insets left="70.0" />
               </VBox.margin>
            </HBox>
            <ScrollPane hbarPolicy="NEVER" prefHeight="650.0" prefWidth="1200.0">
               <content>
                  <VBox fx:id="stageContainer" alignment="TOP_CENTER" prefHeight="650.0" prefWidth="1200.0" spacing="20.0">
                     <padding>
                        <Insets bottom="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>
