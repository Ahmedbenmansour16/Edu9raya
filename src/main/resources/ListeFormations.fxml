<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListeFormationsController">
    <children>
        <HBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox id="sidebar" prefHeight="700.0" prefWidth="220.0" spacing="15.0" styleClass="sidebar">
                    <children>
                        <Label styleClass="app-title" text="Edu9raya">
                            <VBox.margin>
                                <Insets bottom="15.0" top="30.0" />
                            </VBox.margin>
                        </Label>
                        <Label styleClass="sidebar-section" text="Formations">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#refreshFormations" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des formations">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#ouvrirAjouterFormation" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter formation">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Label styleClass="sidebar-section" text="Réclamations">
                            <VBox.margin>
                                <Insets bottom="10.0" top="20.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#ouvrirListeReclamations" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Gestion des réclamations">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="📩" />
                            </graphic>
                        </Button>
                        <Label styleClass="sidebar-section" text="Cours">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#ouvrirListeCours" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des cours">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#ouvrirAjouterCours" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter cours">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>

                        <Label styleClass="sidebar-section" text="Modules">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#ouvrirListeModules" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des modules">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#ouvrirAjouterModule" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter module">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>

                        <Label styleClass="sidebar-section" text="Catégories">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#ouvrirListeCategories" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des catégories">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#ouvrirAjouterCategorie" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter catégorie">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                  <Label styleClass="sidebar-section" text="Stage">
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Label>
                  <Button mnemonicParsing="false" onAction="#ouvrirGestionStage" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Gestion Des Stages">
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
                        <Button fx:id="logoutBtn" mnemonicParsing="false" styleClass="sidebar-button" text="Déconnexion">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </VBox>
                <VBox prefHeight="700.0" prefWidth="980.0" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="header-bar">
                            <children>
                                <Label styleClass="page-title" text="Liste des Formations">
                                    <HBox.margin>
                                        <Insets left="25.0" />
                                    </HBox.margin>
                                </Label>
                                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="notificationBtn" styleClass="notification-btn">
                                            <graphic>
                                                <HBox spacing="5.0" alignment="CENTER">
                                                    <children>
                                                        <Label styleClass="notification-icon" text="🔔" />
                                                        <Label fx:id="notificationCount" styleClass="notification-badge" text="0" />
                                                    </children>
                                                </HBox>
                                            </graphic>
                                            <HBox.margin>
                                                <Insets right="25.0" />
                                            </HBox.margin>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                        <VBox alignment="TOP_CENTER" prefHeight="620.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox maxWidth="1000.0" prefWidth="850.0" spacing="20.0" styleClass="content-container">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-box">
                                            <children>
                                                <Label styleClass="search-label" text="Rechercher:" />
                                                <TextField fx:id="searchField" prefHeight="40.0" promptText="Rechercher par nom, description ou catégorie..." styleClass="search-input" HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#searchFormation" prefHeight="40.0" styleClass="search-button" text="Rechercher">
                                                    <graphic>
                                                        <Label styleClass="button-icon" text="🔍" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </HBox>

                                        <!-- Notification Box -->
                                        <VBox fx:id="notificationBox" styleClass="notification-box" visible="false" AnchorPane.topAnchor="80.0" AnchorPane.rightAnchor="20.0">
                                            <children>
                                                <VBox fx:id="reclamationList" spacing="5.0" />
                                            </children>
                                            <padding>
                                                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
                                            </padding>
                                        </VBox>
                                        <TableView fx:id="tableFormation" prefHeight="500.0" styleClass="modern-table">
                                            <columns>
                                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                                <TableColumn fx:id="colNom" prefWidth="141.0" text="Nom" />
                                                <TableColumn fx:id="colDescription" prefWidth="195.0" text="Description" />
                                                <TableColumn fx:id="colImage" prefWidth="120.0" text="Image" />
                                                <TableColumn fx:id="colDate" prefWidth="99.0" text="Date" />
                                                <TableColumn fx:id="colCategorie" prefWidth="128.0" text="Catégorie" />
                                                <TableColumn fx:id="colActions" prefWidth="206.0" text="Actions" />
                                            </columns>
                                        </TableView>
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
