<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.InscriptionController"
           stylesheets="@styleauth.css"
           prefHeight="650.0" prefWidth="800.0"
           styleClass="root">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox alignment="CENTER" spacing="15" styleClass="main-container"
          maxWidth="550" maxHeight="600">

        <Label text="Inscription" styleClass="title-label">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <Separator />

        <GridPane alignment="CENTER" hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>

            <Label text="Prénom:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="prenomField" promptText="Entrez votre prénom" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="nomField" promptText="Entrez votre nom" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" promptText="Entrez votre email" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Je suis un:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="roleComboBox" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <PasswordField fx:id="passwordField" promptText="Créez votre mot de passe" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Confirmer:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirmez votre mot de passe" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        </GridPane>

        <Label fx:id="errorLabel" textFill="RED" visible="false" wrapText="true" />

        <Button fx:id="inscrireButton" text="S'inscrire" onAction="#handleInscription"
                styleClass="primary-button" prefWidth="200" />

        <HBox alignment="CENTER" spacing="5">
            <Label text="Déjà inscrit ?" />
            <Hyperlink fx:id="connectLink" text="Connectez-vous" onAction="#ouvrirConnexion" />
        </HBox>

    </VBox>
</StackPane>