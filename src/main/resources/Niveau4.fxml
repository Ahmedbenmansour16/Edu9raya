<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Niveau4Controller">
    <children>
        <HBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox id="sidebar" prefHeight="700.0" prefWidth="220.0" styleClass="sidebar">
                    <children>
                        <Label styleClass="app-title" text="Edu9raya">
                            <VBox.margin>
                                <Insets bottom="30.0" top="30.0" />
                            </VBox.margin>
                        </Label>
                        <Label styleClass="sidebar-section" text="Niveaux">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Button fx:id="niveau1Btn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Niveau 1">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="1️⃣" />
                            </graphic>
                        </Button>
                        <Button fx:id="niveau2Btn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Niveau 2">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="2️⃣" />
                            </graphic>
                        </Button>
                        <Button fx:id="niveau3Btn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Niveau 3">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="3️⃣" />
                            </graphic>
                        </Button>
                        <Button fx:id="niveau4Btn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button, sidebar-button-active" text="Niveau 4">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="4️⃣" />
                            </graphic>
                        </Button>
                        <Button fx:id="niveau5Btn" mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Niveau 5">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="5️⃣" />
                            </graphic>
                        </Button>
                        <Label styleClass="sidebar-section" text="Navigation">
                            <VBox.margin>
                                <Insets bottom="10.0" top="20.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Retour à l'accueil">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="🏠" />
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </VBox>
                <VBox prefHeight="700.0" prefWidth="980.0" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="header-bar">
                            <children>
                                <Label styleClass="page-title" text="Niveau 4">
                                    <HBox.margin>
                                        <Insets left="25.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                        <VBox alignment="CENTER" prefHeight="620.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox maxWidth="800.0" prefWidth="750.0" spacing="25.0" styleClass="content-container">
                                    <children>
                                        <VBox spacing="15.0" styleClass="form-section">
                                            <children>
                                                <Label styleClass="form-section-title" text="Sélection du type de contenu">
                                                    <VBox.margin>
                                                        <Insets bottom="10.0" />
                                                    </VBox.margin>
                                                </Label>
                                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                                    <children>
                                                        <Label styleClass="input-label" text="Type de contenu:" />
                                                        <ComboBox fx:id="typeContenuCombo" prefHeight="40.0" prefWidth="350.0" promptText="Sélectionnez un type de contenu" styleClass="modern-combo" />
                                                    </children>
                                                </HBox>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                        <VBox styleClass="content-display-section">
                                            <children>
                                                <Label styleClass="form-section-title" text="Contenu du niveau">
                                                    <VBox.margin>
                                                        <Insets bottom="10.0" />
                                                    </VBox.margin>
                                                </Label>
                                                <VBox fx:id="dynamicContainer" prefHeight="300.0" prefWidth="720.0" styleClass="dynamic-container" />
                                            </children>
                                            <padding>
                                                <Insets bottom="15.0" left="15.0" right="15.0" top="10.0" />
                                            </padding>
                                        </VBox>
                                        <HBox alignment="BASELINE_RIGHT" spacing="15.0">
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#ajouterContenu" prefHeight="45.0" styleClass="btn-primary" text="Ajouter ce contenu">
                                                    <graphic>
                                                        <Label styleClass="button-icon" text="➕" />
                                                    </graphic>
                                                </Button>
                                                <Button alignment="CENTER_RIGHT" mnemonicParsing="false" onAction="#passerNiveau5" prefHeight="45.0" styleClass="btn-next" text="Suivant">
                                                    <graphic>
                                                        <Label styleClass="button-icon" text="➡️" />
                                                    </graphic>
                                                </Button>
                                            </children>
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="30.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>