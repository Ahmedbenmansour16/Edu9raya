<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Module.ModuleDetails">
    <children>
        <HBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Sidebar -->
                <fx:include source="../SideBar.fxml" />

                <!-- Main content area -->
                <VBox prefHeight="700.0" prefWidth="980.0" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <!-- Navigation Bar -->
                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="header-bar">
                            <children>
                                <Label text="Détails du Module" styleClass="page-title">
                                    <HBox.margin>
                                        <Insets left="25.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Module Details Form -->
                        <VBox alignment="CENTER" prefHeight="620.0" prefWidth="980.0" spacing="20.0" styleClass="content-container">
                            <padding>
                                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
                            </padding>
                            <children>
                                <TextField fx:id="nomField" promptText="Nom du module" styleClass="form-field" />
                                <TextArea fx:id="descriptionArea" prefHeight="100.0" promptText="Description du module" styleClass="form-field" wrapText="true" />
                                <TextField fx:id="dureeField" promptText="Durée (en heures)" styleClass="form-field" />
                                <TextField fx:id="niveauField" promptText="Niveau" styleClass="form-field" />
                                
                                <!-- Buttons -->
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" text="Enregistrer" styleClass="primary-button" />
                                        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Annuler" styleClass="secondary-button" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane> 