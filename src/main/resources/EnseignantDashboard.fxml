<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.EnseignantDashboardController"
            prefHeight="600.0" prefWidth="800.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #3498db; -fx-padding: 10px;">
            <Label text="Interface Enseignant" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="labelUserName" style="-fx-text-fill: white;" />
            <Button fx:id="btnLogout" text="Déconnexion" onAction="#handleLogout" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Bienvenue dans l'espace enseignant" style="-fx-font-size: 24px;" />
            <Label text="Cette interface sera développée prochainement." style="-fx-font-size: 16px;" />

            <Button text="Voir les formations" onAction="#viewFormations" prefWidth="200" />
        </VBox>
    </center>
</BorderPane>