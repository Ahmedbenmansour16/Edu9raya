<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HomeController">
    <children>
        <VBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <!-- Navigation Bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0" styleClass="nav-bar">
                <children>
                    <!-- Logo -->
                    <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <children>
                            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@images/logo.jpg" />
                                </image>
                            </ImageView>
                            <Label styleClass="brand-name" text="Edu9raya">
                                <HBox.margin>
                                    <Insets left="10.0" />
                                </HBox.margin>
                            </Label>
                        </children>
                        <HBox.margin>
                            <Insets left="20.0" />
                        </HBox.margin>
                    </HBox>

                    <!-- Navigation Links -->
                    <HBox alignment="CENTER" spacing="30.0">
                        <children>
                            <Button fx:id="homeBtn" mnemonicParsing="false" styleClass="nav-button, active-nav" text="Home" />
                            <Button fx:id="formationBtn" mnemonicParsing="false" styleClass="nav-button" text="formation" />
                            <Button fx:id="reclamationsBtn" mnemonicParsing="false" styleClass="nav-button" text="Mes réclamations" />
                        </children>
                    </HBox>

                    <!-- User Profile -->
                    <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                        <children>
                            <Label fx:id="userNameLabel" styleClass="user-name-label">
                                <HBox.margin>
                                    <Insets right="10.0" />
                                </HBox.margin>
                            </Label>
                            <Button fx:id="profileBtn" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" styleClass="profile-btn">
                                <graphic>
                                    <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@images/profile.jpg" />
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="logoutBtn" mnemonicParsing="false" styleClass="logout-btn" text="Déconnexion">
                                <HBox.margin>
                                    <Insets left="10.0" />
                                </HBox.margin>
                            </Button>
                        </children>
                        <HBox.margin>
                            <Insets right="20.0" />
                        </HBox.margin>
                    </HBox>
                </children>
            </HBox>

            <!-- Main Content -->
            <VBox prefHeight="630.0" styleClass="main-content" VBox.vgrow="ALWAYS">
                <!-- Titre principal -->
                <Label styleClass="main-title" text="Tableau de bord">
                    <VBox.margin>
                        <Insets bottom="20.0" top="20.0" />
                    </VBox.margin>
                </Label>

                <!-- Statistiques générales -->
                <Label styleClass="section-title" text="Statistiques des Tests">
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </Label>

                <HBox spacing="30" alignment="CENTER" styleClass="stats-summary">
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                    <children>
                        <VBox alignment="CENTER" styleClass="stat-box">
                            <Label fx:id="lblTotalCertificats" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Certificats délivrés" />
                        </VBox>
                        <VBox alignment="CENTER" styleClass="stat-box">
                            <Label fx:id="lblScoreMoyen" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Score moyen" />
                        </VBox>
                        <VBox alignment="CENTER" styleClass="stat-box">
                            <Label fx:id="lblMeilleurScore" styleClass="stat-value" text="0" />
                            <Label styleClass="stat-label" text="Meilleur score" />
                        </VBox>
                    </children>
                </HBox>

                <!-- Classement des meilleurs étudiants avec graphique -->
                <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                    <children>
                        <!-- Top 3 étudiants avec graphique -->
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="card">
                            <Label styleClass="subsection-title" text="Top 3 Étudiants" />

                            <!-- Bar Chart pour les top 3 étudiants -->
                            <BarChart fx:id="topStudentsChart" legendVisible="false" prefHeight="300.0">
                                <xAxis>
                                    <CategoryAxis side="BOTTOM" fx:id="xAxis" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis side="LEFT" fx:id="yAxis" label="Score" autoRanging="false" lowerBound="0" upperBound="100" tickUnit="10" />
                                </yAxis>
                            </BarChart>

                            <!-- Conteneur pour le podium (images) -->
                            <AnchorPane fx:id="topStudentsContainer" styleClass="top-students-container" prefHeight="150.0" />
                        </VBox>

                        <!-- Sélection et affichage du classement complet -->
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="card">
                            <Label styleClass="subsection-title" text="Classement par test" />
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <ComboBox fx:id="comboTests" prefWidth="200.0" promptText="Choisir un test" />
                                <Button fx:id="btnAfficherClassement" text="Afficher le classement" styleClass="action-btn" />
                            </HBox>
                            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="classement-scroll">
                                <VBox fx:id="classementContainer" styleClass="classement-container" spacing="5.0" />
                            </ScrollPane>
                        </VBox>
                    </children>
                </HBox>

                <!-- Liens rapides vers les formations -->
                <Label styleClass="section-title" text="Accès Rapide">
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Label>

                <HBox spacing="20.0" alignment="CENTER">
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                    <Button fx:id="btnVoirFormations" styleClass="action-btn-large" text="Voir toutes les formations" />
                    <Button fx:id="btnMesCertificats" styleClass="action-btn-large" text="Mes certificats" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>