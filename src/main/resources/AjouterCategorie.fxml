<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterCategorieController">
    <children>
        <HBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox id="sidebar" prefHeight="700.0" prefWidth="220.0" styleClass="sidebar">
                    <children>
                        <Label styleClass="app-title" text="Edu9raya">
                            <VBox.margin>
                                <Insets bottom="30.0" top="30.0" />
                            </VBox.margin>
                        </Label>
                        <Label styleClass="sidebar-section" text="Formations">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des formations">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="📋" />
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter formation">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                        <Label styleClass="sidebar-section" text="Catégories">
                            <VBox.margin>
                                <Insets bottom="10.0" top="20.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des catégories">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="🗂️" />
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter catégorie">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </VBox>
                <VBox prefHeight="700.0" prefWidth="980.0" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="header-bar">
                            <children>
                                <Label styleClass="page-title" text="Ajouter une Catégorie">
                                    <HBox.margin>
                                        <Insets left="25.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                        <VBox alignment="CENTER" prefHeight="620.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox maxWidth="600.0" prefWidth="550.0" spacing="30.0" styleClass="content-container">
                                    <children>
                                        <VBox spacing="15.0" styleClass="form-group">
                                            <Label styleClass="form-label" text="Nom de la catégorie">
                                                <font>
                                                    <javafx.scene.text.Font size="18.0" />
                                                </font>
                                            </Label>
                                            <TextField fx:id="nomcategorie" prefHeight="50.0" promptText="Saisissez le nom de la catégorie" styleClass="search-input" />
                                        </VBox>
                                        <HBox alignment="CENTER" spacing="20.0" prefHeight="80.0">
                                            <Button cancelButton="true" mnemonicParsing="false" text="Annuler" prefHeight="45.0" prefWidth="160.0" styleClass="btn-cancel" onAction="#retournerALaListe" >
                                                <graphic>
                                                    <Label styleClass="button-icon" text="✖" />
                                                </graphic>
                                            </Button>
                                            <Button defaultButton="true" mnemonicParsing="false" onAction="#ajouterCategorie" prefHeight="45.0" prefWidth="160.0" styleClass="search-button" text="Ajouter">
                                                <graphic>
                                                    <Label styleClass="button-icon" text="✓" />
                                                </graphic>
                                            </Button>
                                        </HBox>
                                    </children>
                                    <padding>
                                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                                    </padding>
                                    <VBox.margin>
                                        <Insets top="50.0" />
                                    </VBox.margin>
                                    <styleClass>
                                        <String fx:value="content-container" />
                                        <String fx:value="form-container" />
                                    </styleClass>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>