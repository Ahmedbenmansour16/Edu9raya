<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.BookDetailsController"
      spacing="15"
      alignment="TOP_CENTER"
      styleClass="card">
    <!-- Correct padding declaration -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Titre -->
    <Label text="Détails du Livre"
           styleClass="label-title"/>

    <!-- Zone de texte : deux colonnes étiquettes / valeurs -->
    <VBox spacing="10" styleClass="details-container">
        <HBox spacing="5">
            <Label text="ID :" styleClass="label-field"/>
            <Label fx:id="idBookLabel" styleClass="label-value"/>
        </HBox>
        <HBox spacing="5">
            <Label text="Nom :" styleClass="label-field"/>
            <Label fx:id="nomBookLabel" styleClass="label-value"/>
        </HBox>
        <HBox spacing="5">
            <Label text="Catégorie :" styleClass="label-field"/>
            <Label fx:id="catBookLabel" styleClass="label-value"/>
        </HBox>
        <HBox spacing="5">
            <Label text="Disponibilité :" styleClass="label-field"/>
            <Label fx:id="dispoBookLabel" styleClass="label-value"/>
        </HBox>
        <VBox spacing="4">
            <Label text="Description :" styleClass="label-field"/>
            <Label fx:id="descriptionLabel"
                   wrapText="true"
                   styleClass="label-value"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Fichier PDF :" styleClass="label-field"/>
            <Label fx:id="pdfFileLabel"
                   wrapText="true"
                   styleClass="label-value"/>
        </VBox>
    </VBox>

    <!-- Images côte à côte -->
    <HBox spacing="30" alignment="CENTER">
        <VBox alignment="CENTER" spacing="5">
            <Label text="Couverture" styleClass="label-subtitle"/>
            <ImageView fx:id="bookImageView"
                       fitWidth="200"
                       preserveRatio="true"
                       smooth="truµ
                       e"
                       styleClass="image-view"/>
        </VBox>
        <VBox alignment="CENTER" spacing="5">
            <Label text="QR Code" styleClass="label-subtitle"/>
            <ImageView fx:id="qrCodeImageView"
                       fitWidth="150"
                       preserveRatio="true"
                       smooth="true"
                       styleClass="image-view"/>
        </VBox>
    </HBox>

    <!-- Boutons d’action -->
    <HBox spacing="20" alignment="CENTER">
        <Button text="Télécharger PDF"
                onAction="#handleDownloadPdf"
                styleClass="btn-primary"/>
        <Button text="Lire le PDF"
                onAction="#handleReadPdf"
                styleClass="btn-secondary"/>
    </HBox>
</VBox>