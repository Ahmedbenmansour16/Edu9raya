<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.LoginController"
           prefHeight="500.0" prefWidth="800.0"
           stylesheets="@styleauth.css"
           styleClass="root">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox alignment="CENTER" spacing="20" styleClass="main-container"
          maxWidth="500" maxHeight="450">

        <Label text="Connexion" styleClass="title-label">
            <font>
                <Font name="System Bold" size="28.0"/>
            </font>
        </Label>

        <Separator />

        <GridPane alignment="CENTER" hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="emailField" promptText="Entrez votre email" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Mot de passe:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        </GridPane>

        <Label fx:id="errorLabel" textFill="RED" visible="false" wrapText="true" />

        <Button fx:id="connectButton" text="Se connecter" onAction="#handleConnexion"
                styleClass="primary-button" prefWidth="200" />

        <HBox alignment="CENTER" spacing="5">
            <Label text="Pas encore de compte ?" />
            <Hyperlink fx:id="inscrireLink" text="S'inscrire" onAction="#ouvrirInscription" />
        </HBox>

        <Button fx:id="inscrireButton" text="Créer un compte" onAction="#ouvrirInscription"
                styleClass="secondary-button" prefWidth="200" />

    </VBox>
</StackPane>