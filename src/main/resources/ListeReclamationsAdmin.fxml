<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListeReclamationsAdminController">
    <children>
        <HBox prefHeight="700.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox id="sidebar" prefHeight="700.0" prefWidth="220.0" styleClass="sidebar">
                    <children>
                        <Label styleClass="app-title" text="Edu9raya">
                            <VBox.margin>
                                <Insets bottom="30.0" top="30.0" />
                            </VBox.margin>
                        </Label>
                        <Label styleClass="sidebar-section" text="Formations">
                            <VBox.margin>
                                <Insets bottom="10.0" top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#ouvrirListeFormations" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des formations">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="📋" />
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#ajouterFormation" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter formation">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                        <Label styleClass="sidebar-section" text="Catégories">
                            <VBox.margin>
                                <Insets bottom="10.0" top="20.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#ouvrirListeCategories" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Liste des catégories">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="🗂️" />
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#ouvrirAjouterCategorie" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button" text="Ajouter catégorie">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="➕" />
                            </graphic>
                        </Button>
                        <Label styleClass="sidebar-section" text="Réclamations">
                            <VBox.margin>
                                <Insets bottom="10.0" top="20.0" />
                            </VBox.margin>
                        </Label>
                        <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="220.0" styleClass="sidebar-button, active-sidebar-button" text="Gestion des réclamations">
                            <VBox.margin>
                                <Insets bottom="8.0" top="5.0" />
                            </VBox.margin>
                            <graphic>
                                <Label styleClass="button-icon" text="📩" />
                            </graphic>
                        </Button>
                        <Button fx:id="logoutBtn" mnemonicParsing="false" styleClass="sidebar-button" text="Déconnexion">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </VBox>
                <VBox prefHeight="700.0" prefWidth="980.0" styleClass="main-content" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="80.0" styleClass="header-bar">
                            <children>
                                <Label styleClass="page-title" text="Gestion des réclamations">
                                    <HBox.margin>
                                        <Insets left="25.0" />
                                    </HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                        <VBox alignment="CENTER" prefHeight="620.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox maxWidth="1000.0" prefWidth="850.0" spacing="20.0" styleClass="content-container">
                                    <children>
                                        <TableView fx:id="tableReclamation" prefHeight="500.0" styleClass="modern-table">
                                            <columns>
                                                <TableColumn fx:id="colEtudiant" prefWidth="150.0" text="Étudiant" />
                                                <TableColumn fx:id="colSujet" prefWidth="150.0" text="Sujet" />
                                                <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                                                <TableColumn fx:id="colStatut" prefWidth="100.0" text="Statut" />
                                                <TableColumn fx:id="colActions" prefWidth="250.0" text="Actions" />
                                            </columns>
                                        </TableView>
                                    </children>
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                    </padding>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>